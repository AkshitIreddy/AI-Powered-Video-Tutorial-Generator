@@ -444,6 +445,24 @@ class LivePortraitWrapper(object):
 
         if args.is_smooth_motion:
             tgt_motion = smooth_(tgt_motion, method="ema")
+        if args.motion_offset_frames > 0 and tgt_motion['motion']:
+            offset = min(args.motion_offset_frames, len(tgt_motion['motion']) - 1)
+            if offset > 0:
+                tail = tgt_motion['motion'][-1]
+                tgt_motion['motion'] = tgt_motion['motion'][offset:] + [tail] * offset
+        if args.enable_speech_gate:
+            gate = []
+            samples_per_frame = 16000.0 / self.fps
+            db_range = max(args.speech_gate_ceiling_db - args.speech_gate_floor_db, 1e-6)
+            for frame_idx in range(tgt_motion['n_frames']):
+                center = (frame_idx + 0.5) * samples_per_frame
+                start = max(0, round(center - samples_per_frame))
+                end = min(len(audio_np), round(center + samples_per_frame))
+                frame_audio = audio_np[start:end]
+                rms = float(np.sqrt(np.mean(frame_audio * frame_audio))) if len(frame_audio) else 0.0
+                dbfs = 20.0 * np.log10(max(rms, 1e-9))
+                gate.append(float(np.clip((dbfs - args.speech_gate_floor_db) / db_range, 0.0, 1.0)))
+            tgt_motion['speech_gate'] = gate
         return tgt_motion
     
 
