{
  "name": "@alystria/renderer",
  "version": "2.0.0-rc.0",
  "private": true,
  "description": "Deterministic frame-driven renderer and FFmpeg planner for Alystria Studio.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./browser": "./dist/src/browser.js",
    "./captions": "./dist/src/captions.js",
    "./ffmpeg": "./dist/src/ffmpeg.js",
    "./timebase": "./dist/src/timebase.js"
  },
  "bin": {
    "alystria-renderer": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@alystria/scenes": "workspace:*",
    "playwright-core": "1.62.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "test:unit": "pnpm run test",
    "test:render": "tsc -p tsconfig.json && node --test dist/tests/render.test.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.8.3"
  }
}
